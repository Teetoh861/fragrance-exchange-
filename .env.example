# Database — Postgres (a free Neon or Supabase project works well). Required
# both locally and in production; Vercel's serverless functions have no
# writable/persistent local disk, so SQLite will not work there.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth
AUTH_SECRET="replace-with-a-long-random-string"

# Google OAuth (optional — leave blank to disable Google sign-in)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Paystack (get test keys from https://dashboard.paystack.com)
PAYSTACK_SECRET_KEY=""
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""

# Admin bootstrap — the account with this email is auto-promoted to ADMIN on signup/login
ADMIN_EMAIL="you@example.com"

# File uploads are stored under /public/uploads by default (dev only).
# For production, point this at a real object store and adapt lib/storage.ts.
UPLOAD_DIR="./public/uploads"
