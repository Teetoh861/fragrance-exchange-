# Database — Neon Postgres (project: Fragrance exchange, dry-union-17650627).
# Required both locally and in production; Vercel's serverless functions have
# no writable/persistent local disk, so SQLite will not work there.
# DATABASE_URL: pooled connection (hostname has a "-pooler" suffix) — used
#   for normal app/query traffic.
# DATABASE_URL_UNPOOLED: direct connection (no "-pooler" suffix) — used only
#   for `prisma db push` / migrations, which need session-level operations.
# Get both from the Neon console: Project > Connect > Connection string
# (toggle "Pooled connection" to get each variant).
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require"

# NextAuth
AUTH_SECRET="replace-with-a-long-random-string"

# Google OAuth (optional — leave blank to disable Google sign-in)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Paystack (get test keys from https://dashboard.paystack.com)
PAYSTACK_SECRET_KEY=""
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""

# Admin bootstrap — the account with this email is auto-promoted to ADMIN on signup/login
ADMIN_EMAIL="you@example.com"

# Neon Object Storage — listing/shipment photo uploads (lib/storage.ts).
# Get these from the Neon console's Storage tab for the "fragrance-exchange"
# bucket (declared in neon.ts), or via `neon env pull` after `neon deploy`.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_ENDPOINT_URL_S3=""
AWS_REGION="us-east-2"
